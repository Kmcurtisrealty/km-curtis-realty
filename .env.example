# Resend (https://resend.com) — required for the /contact and property inquiry
# forms to deliver email. Create an account, verify a sending domain, and
# generate an API key, then copy this file to `.env.local` and fill in real
# values. `.env.local` is gitignored and must never be committed.

# Resend API key from the Resend dashboard.
RESEND_API_KEY=

# The "from" address Resend sends as. Until a sending domain is DNS-verified
# in Resend, you must use the shared onboarding@resend.dev address here.
# Once a real domain (e.g. kmcurtisrealty.com) is verified in Resend, switch
# this to an address on that domain (e.g. leads@kmcurtisrealty.com).
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where lead notification emails are delivered. Resend's shared
# onboarding@resend.dev sender can only deliver to the email address the
# Resend account itself is registered under, so for local/dev testing this
# should temporarily be set to that same account email. Once a sending
# domain is verified, switch this to kmcurtisrealty@gmail.com.
LEAD_NOTIFICATION_EMAIL=kmcurtisrealty@gmail.com
